### Step 5: Update Module Dependencies

```go
// File: x/contracts/module/depinject.go
type ModuleInputs struct {
    depinject.In

    Cdc           codec.Codec
    StoreService  store.KVStoreService
    Logger        log.Logger
    AccountKeeper authkeeper.AccountKeeper
    BankKeeper    bankkeeper.Keeper
    StakingKeeper *stakingkeeper.Keeper
    
    // Add IBC dependencies
    IBCKeeper      *ibckeeper.Keeper         `optional:"true"`
    TransferKeeper ibctransferkeeper.Keeper  `optional:"true"`

    Config *contractstypes.Module
}

func ProvideModule(in ModuleInputs) ModuleOutputs {
    var channelKeeper channeltypes.ChannelKeeper
    var portKeeper porttypes.PortKeeper
    var transferKeeper ibctransferkeeper.Keeper
    
    if in.IBCKeeper != nil {
        channelKeeper = in.IBCKeeper.ChannelKeeper
        portKeeper = in.IBCKeeper.PortKeeper
    }
    
    if in.TransferKeeper != nil {
        transferKeeper = in.TransferKeeper
    }

    k := keeper.NewKeeper(
        in.Cdc,
        in.StoreService,
        in.Logger,
        in.AccountKeeper,
        in.BankKeeper,
        *in.StakingKeeper,
        channelKeeper,
        portKeeper,
        transferKeeper,
        defaultHomeDir,
    )
    
    // ... rest of implementation
}
