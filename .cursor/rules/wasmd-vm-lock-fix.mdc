### Step 4: Add Error Handling with Retry
**File**: `x/contracts/keeper/keeper.go`
**Change**: Enhance `getWasmKeeper()` function
```go
func (k *Keeper) getWasmKeeper() *wasmkeeper.Keeper {
    k.once.Do(func() {
        const maxRetries = 3
        const retryDelay = 50 * time.Millisecond
        
        for attempt := 0; attempt < maxRetries; attempt++ {
            if err := k.initializeWasmKeeper(); err != nil {
                k.logger.Error("Failed to initialize wasm keeper", 
                    "attempt", attempt+1, 
                    "error", err)
                if attempt < maxRetries-1 {
                    time.Sleep(retryDelay)
                    continue
                }
                panic(fmt.Sprintf("Could not initialize wasm keeper after %d attempts: %v", 
                    maxRetries, err))
            }
            break
        }
    })
    return k.wasmKeeper
}
```

### Step 5: Extract Initialization Logic
