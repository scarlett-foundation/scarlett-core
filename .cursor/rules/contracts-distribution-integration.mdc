### Step 5: Implement Distribution Handlers

```go
// File: x/contracts/keeper/distribution_handlers.go
package keeper

// Handle distribution messages from contracts
func (k Keeper) HandleDistributionMsg(
    ctx sdk.Context,
    contractAddr sdk.AccAddress,
    msg ContractDistributionMsg,
) error {
    switch {
    case msg.WithdrawDelegationRewards != nil:
        return k.handleWithdrawDelegationRewards(ctx, contractAddr, msg.WithdrawDelegationRewards)
    case msg.WithdrawValidatorCommission != nil:
        return k.handleWithdrawValidatorCommission(ctx, contractAddr, msg.WithdrawValidatorCommission)
    case msg.FundCommunityPool != nil:
        return k.handleFundCommunityPool(ctx, contractAddr, msg.FundCommunityPool)
    default:
        return errors.New("unknown distribution message")
    }
}

func (k Keeper) handleWithdrawDelegationRewards(
    ctx sdk.Context,
    contractAddr sdk.AccAddress,
    msg *WithdrawDelegationRewardsMsg,
) error {
    valAddr, err := sdk.ValAddressFromBech32(msg.ValidatorAddress)
    if err != nil {
        return err
    }
    
    if k.wasmKeeper == nil {
        return ErrWasmNotInitialized
    }
    
    // Use the distribution adapter to withdraw rewards
    _, err = k.distributionAdapter.WithdrawDelegationRewards(ctx, contractAddr, valAddr)
    return err
}

func (k Keeper) handleWithdrawValidatorCommission(
    ctx sdk.Context,
    contractAddr sdk.AccAddress,
    msg *WithdrawValidatorCommissionMsg,
) error {
    valAddr, err := sdk.ValAddressFromBech32(msg.ValidatorAddress)
    if err != nil {
        return err
    }
    
    // Check if contract is authorized to withdraw commission for this validator
    // This would require additional authorization logic
    
    if k.wasmKeeper == nil {
        return ErrWasmNotInitialized
    }
    
    // Withdraw validator commission
    _, err = k.distributionKeeper.WithdrawValidatorCommission(ctx, valAddr)
    return err
}

func (k Keeper) handleFundCommunityPool(
    ctx sdk.Context,
    contractAddr sdk.AccAddress,
    msg *FundCommunityPoolMsg,
) error {
    if k.wasmKeeper == nil {
        return ErrWasmNotInitialized
    }
    
    // Transfer tokens from contract to community pool
    return k.distributionKeeper.FundCommunityPool(ctx, msg.Amount, contractAddr)
}
```

