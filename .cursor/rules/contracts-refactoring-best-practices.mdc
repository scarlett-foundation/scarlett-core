### 3. Keeper Interface Abstraction

#### Current Direct Access
```go
// Direct wasmd keeper access throughout codebase
k.wasmKeeper.GetContractInfo(ctx, contractAddr)
k.wasmKeeper.QuerySmart(ctx, contractAddr, queryData)
```

#### Improved Interface Layer
```go
// File: x/contracts/keeper/interfaces.go
package keeper

// ContractKeeper defines the interface for contract operations
type ContractKeeper interface {
    // Contract lifecycle
    StoreContract(ctx context.Context, creator sdk.AccAddress, wasmCode []byte) (uint64, error)
    InstantiateContract(ctx context.Context, codeID uint64, creator sdk.AccAddress, admin sdk.AccAddress, msg []byte, label string, funds sdk.Coins) (sdk.AccAddress, error)
    ExecuteContract(ctx context.Context, contractAddr sdk.AccAddress, caller sdk.AccAddress, msg []byte, funds sdk.Coins) error
    
    // Contract queries
    QueryContract(ctx context.Context, contractAddr sdk.AccAddress, queryMsg []byte) ([]byte, error)
    GetContractInfo(ctx context.Context, contractAddr sdk.AccAddress) (*ContractInfo, error)
    GetCodeInfo(ctx context.Context, codeID uint64) (*CodeInfo, error)
    
    // Contract management
    UpdateContractAdmin(ctx context.Context, contractAddr sdk.AccAddress, caller sdk.AccAddress, newAdmin sdk.AccAddress) error
    MigrateContract(ctx context.Context, contractAddr sdk.AccAddress, caller sdk.AccAddress, newCodeID uint64, msg []byte) error
    
    // Contract state
    GetContractState(ctx context.Context, contractAddr sdk.AccAddress) ([]ContractStateEntry, error)
    GetContractHistory(ctx context.Context, contractAddr sdk.AccAddress) ([]ContractCodeHistoryEntry, error)
}

// Implementation that wraps wasmd keeper
type wasmContractKeeper struct {
    wasmKeeper *wasmkeeper.Keeper
    config     ContractsConfig
    logger     log.Logger
}

func NewContractKeeper(wasmKeeper *wasmkeeper.Keeper, config ContractsConfig, logger log.Logger) ContractKeeper {
    return &wasmContractKeeper{
        wasmKeeper: wasmKeeper,
        config:     config,
        logger:     logger,
    }
}

func (k *wasmContractKeeper) StoreContract(ctx context.Context, creator sdk.AccAddress, wasmCode []byte) (uint64, error) {
    // Add validation, logging, metrics
    if len(wasmCode) > int(k.config.NodeConfig.MaxContractSize) {
        return 0, fmt.Errorf("contract size %d exceeds maximum %d", len(wasmCode), k.config.NodeConfig.MaxContractSize)
    }
    
    // Check security constraints
    if len(k.config.Security.AllowedUploaders) > 0 {
        if !contains(k.config.Security.AllowedUploaders, creator.String()) {
            return 0, fmt.Errorf("uploader %s not in allowed list", creator.String())
        }
    }
    
    k.logger.Info("Storing contract", "creator", creator.String(), "size", len(wasmCode))
    
    // Delegate to wasmd with proper error handling
    msg := &wasmtypes.MsgStoreCode{
        Sender:       creator.String(),
        WASMByteCode: wasmCode,
        InstantiatePermission: &wasmtypes.AccessConfig{
            Permission: wasmtypes.AccessTypeEverybody,
        },
    }
    
    msgServer := wasmkeeper.NewMsgServerImpl(k.wasmKeeper)
    resp, err := msgServer.StoreCode(ctx, msg)
    if err != nil {
        k.logger.Error("Failed to store contract", "error", err)
        return 0, err
    }
    
    k.logger.Info("Successfully stored contract", "code_id", resp.CodeID)
    return resp.CodeID, nil
}
```

